# 项目名，会影响容器名、镜像名和 Docker 网络名
COMPOSE_PROJECT_NAME=emby115-gateway

# Emby 网关入口端口。通过这个端口访问 Emby Web，并自动注入外部播放器按钮
GATEWAY_PORT=8097

# 后台管理端口。建议只允许内网/VPN 访问
ADMIN_PORT=8098

# 后台初始账号。首次登录后可在后台修改密码
ADMIN_INIT_USER=admin

# 后台初始密码。首次登录后请立即修改
ADMIN_INIT_PASSWORD=change-me-please

# 应用签名密钥。生产环境建议填入随机长字符串；留空则每次容器重启自动生成，已登录会话会失效
APP_SECRET_KEY=

# 后台 Cookie 是否仅允许 HTTPS 传输。公网 HTTPS 反代时建议改为 true
SESSION_COOKIE_SECURE=false

# STRM 输出根目录挂载。Docker 必须在启动前知道这个宿主机目录
# 容器内固定映射为 /strm-output，后台只需要配置 /strm-output 和各媒体源输出子目录
STRM_OUTPUT_HOST=./strm-output

# Emby Web 反代上游。默认使用宿主机 8096 端口；通常不需要修改
EMBY_UPSTREAM=http://host.docker.internal:8096

